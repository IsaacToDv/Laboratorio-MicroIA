{
  "generator": {
    "dim": 10000,
    "max_sentences": 3000,
    "default_temperature": 0.7,
    "default_max_words": 20
  },
  "identity": {
    "default": "contemporaneo",
    "available": ["poeta", "filosofo", "narrador", "ensayista", "contemporaneo"]
  },
  "corpus": {
    "main": "data/corpus/UD_Spanish-AnCora/es_ancora-ud-train.conllu",
    "additional_datasets": "data/datasets/",
    "literature": "data/literature/"
  },
  "generation": {
    "min_words": 5,
    "max_words": 100,
    "temperature_range": [0.1, 2.0],
    "avoid_repetitions": true,
    "fatigue_window": 5
  },
  "output": {
    "save_to_file": false,
    "output_dir": "generated_texts/",
    "timestamp_format": "%Y%m%d_%H%M%S"
  },
  "ui": {
    "use_colors": true,
    "show_banner": true,
    "interactive_mode": true
  }
}
